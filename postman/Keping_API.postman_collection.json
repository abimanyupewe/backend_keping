		{
			"name": "Authentication",
			"item": [
				{
					"name": "1a. Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set(\"bearer_token\", jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alex Keping\",\n  \"email\": \"alex@keping.id\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Mendaftarkan user baru dan menyimpan JWT token ke variabel `bearer_token` koleksi secara otomatis."
					},
					"response": []
				},
				{
					"name": "1b. Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
